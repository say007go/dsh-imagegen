{
  "name": "dsh-imagegen",
  "version": "0.1.0",
  "description": "通用文生图 / 图生图插件：可配置任意 OpenAI 兼容生图中转站（含 duomi 异步协议自动适配），可配置腾讯云 COS，场景预设、宽高比、中文 prompt 增强、参考图压缩省带宽。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "skills/",
    "references/",
    "cordis.patch.yml"
  ],
  "keywords": ["dsh", "imagegen", "duomi", "cos", "text-to-image", "image-to-image"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "cos-nodejs-sdk-v5": "^2.15.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "sharp": ">=0.35.3 <1"
  }
}
