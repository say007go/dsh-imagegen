{
  "name": "dsh-imagegen",
  "version": "0.7.4",
  "description": "DSH文生图/图生图插件：兼容OpenAI风格生图接口，默认适配duomi；标准OpenAI需调整协议、图生图模式和尺寸；文生图和URL参考图无需COS，本地参考图可压缩后存COS；支持自定义提示词后缀。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "references/",
    "icon.svg",
    "screenshots.json",
    "assets/screenshot-1.png",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "imagegen",
    "duomi",
    "cos",
    "text-to-image",
    "image-to-image"
  ],
  "license": "MIT",
  "author": "say007go",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/say007go/dsh-imagegen.git"
  },
  "bugs": {
    "url": "https://github.com/say007go/dsh-imagegen/issues"
  },
  "homepage": "https://github.com/say007go/dsh-imagegen#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "cos-nodejs-sdk-v5": "^2.15.4"
  },
  "optionalDependencies": {
    "sharp": ">=0.35.3 <1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0"
  }
}
