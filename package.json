{
  "name": "dsh-imagegen",
  "version": "0.3.0",
  "description": "DSH文生图/图生图插件：可接入任意OpenAI兼容的生图接口；文生图和使用已有图片链接作为参考图进行图生图都无需配置COS；若希望用本地图片作为参考图进行图生图，需配置腾讯云COS，图片会先自动压缩再存进COS；还支持自定义提示词后缀。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "references/",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "imagegen",
    "duomi",
    "cos",
    "text-to-image",
    "image-to-image"
  ],
  "license": "MIT",
  "author": "say007go",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/say007go/dsh-imagegen.git"
  },
  "bugs": {
    "url": "https://github.com/say007go/dsh-imagegen/issues"
  },
  "homepage": "https://github.com/say007go/dsh-imagegen#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "cos-nodejs-sdk-v5": "^2.15.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "sharp": ">=0.35.3 <1"
  }
}
